# The only configuration StockPulse needs. No paid API keys are required:
# market data and news come from Yahoo Finance's public endpoints, currency
# rates from frankfurter.dev, and charts from TradingView's free widgets.

# Firebase (Cloud Firestore) service account. In the Firebase console:
#   Project settings -> Service accounts -> Generate new private key
# Save the downloaded file in the project root as
# firebase-service-account.json (it is git-ignored) and point to it here:
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# When deploying (e.g. on Vercel) the key file isn't uploaded, so paste the
# whole JSON on one line instead:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...",...}

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# Public URL of the app. In production set your real domain. On Vercel it may
# be left unset: the project's production domain is used automatically.
BETTER_AUTH_URL=http://localhost:3000

# Protects /api/cron/check-alerts, which checks price alerts while nobody has
# the app open. Any long random string; put the same value in the GitHub repo
# secrets (with APP_URL) so .github/workflows/check-alerts.yml can call it.
CRON_SECRET=replace-with-another-long-random-string
